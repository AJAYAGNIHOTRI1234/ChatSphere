PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatsphere?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Cloudinary Media Configuration (Optional - falls back to DataURI if blank)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (For Forgot Password feature)
# Use Gmail with an App Password — NOT your regular Gmail password
# How to get App Password:
#   1. Go to myaccount.google.com > Security > 2-Step Verification > App Passwords
#   2. Create one for "Mail" — it gives a 16-character password


EMAIL_USER=
EMAIL_PASS=